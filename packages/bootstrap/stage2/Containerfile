FROM scratch AS build
ARG GCC_SOURCE
ARG GCC_VERSION
ARG LINUX_SOURCE
ARG LINUX_VERSION
ARG MUSL_SOURCE
ARG MUSL_VERSION
ARG BINUTILS_SOURCE
ARG BINUTILS_VERSION
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV SOURCE_DATE_EPOCH=1
ENV KCONFIG_NOTIMESTAMP=1
ENV BASE_PATH=/usr/sbin:/usr/bin:/sbin:/bin
ENV PATH=${BASE_PATH}
COPY --from=fetch . .
COPY --from=stagex/bootstrap-stage1 . /

RUN --network=none <<-EOF
	set -eux
	tar -xf ${LINUX_SOURCE}
	tar -xzf ${MUSL_SOURCE}
	tar -xf ${BINUTILS_SOURCE}
	tar -xf ${GCC_SOURCE}
	cd gcc-${GCC_VERSION}
	mv ../*.tar.* .; \
	./contrib/download_prerequisites
EOF

# Set environment variables based on target (x86_64 or aarch64)
COPY --chmod=755 <<-'EOF' /env.sh
	export TARGET=${TARGET_ARCH}-linux-musl
	export SYSROOT=/opt/cross-${TARGET_ARCH}
	export PATH=${SYSROOT}/bin:${BASE_PATH}
EOF

# Setup sysroot
COPY --chmod=755 sysroot.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /sysroot.sh
	done
EOF

# Install musl headers
COPY --chmod=755 musl1.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /musl1.sh
	done
EOF

# Build and install cross binutils
COPY --chmod=755 binutils.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /binutils.sh
	done
EOF

# Build and install cross gcc and bootstrap libgcc
COPY --chmod=755 gcc1.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /gcc1.sh
	done
EOF

# Build and install cross musl
COPY --chmod=755 musl2.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /musl2.sh
	done
EOF

# Build and install final libgcc/libstdc++
COPY --chmod=755 gcc2.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /gcc2.sh
	done
EOF

# Build and install linux headers
COPY --chmod=755 linux.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /linux.sh
	done
EOF

# Finalize installation, copy prefixed binaries to /usr/bin
COPY --chmod=755 install.sh /
RUN --network=none <<-EOF
	set -eux
	for arch in aarch64 x86_64; do
		TARGET_ARCH=$arch /install.sh
	done
EOF

FROM scratch AS package
COPY --from=build /rootfs/ /
